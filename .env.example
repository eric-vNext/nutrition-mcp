SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-secret-key

OAUTH_CLIENT_ID=your-client-id
OAUTH_CLIENT_SECRET=your-client-secret

# Exact-match, comma-separated allow-list of redirect_uri values /authorize will
# accept. This is what stops a crafted login link from sending someone else's
# auth code to an attacker's server instead of the real client.
# https://claude.ai/api/mcp/auth_callback is Claude.ai's current custom-connector
# callback (Anthropic has flagged it may move to claude.com — both are listed
# below so a future migration doesn't lock you out). Connecting any other MCP
# client? Check the `registered_clients` table after your first connection
# attempt for the redirect_uri it registered, and add it here too.
OAUTH_ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback

# Google login (optional). When unset, only email/password sign-in is available.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Open Food Facts requires a User-Agent identifying your app + contact, in the
# form "AppName (email)". Used for barcode lookups (lookup_barcode tool).
OFF_USER_AGENT=nutrition-mcp (you@example.com)

PORT=8080
